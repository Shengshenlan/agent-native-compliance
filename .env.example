# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- 出海合规工作台 (contest additions) ---
# Local demo: skip login.
AUTH_DISABLED=true
# Agent LLM: Zhipu GLM via its OpenAI-compatible endpoint (any OpenAI-compatible provider works).
# Put the real key ONLY in .env (gitignored). Never commit it.
AGENT_ENGINE=ai-sdk:openai
AGENT_MODEL=glm-5.3-flash
LLM_MODEL=glm-5.3-flash
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
OPENAI_API_KEY=
